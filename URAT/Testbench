`timescale 1ns / 1ps

module uart_tb;
    reg clk;
    reg rst_n;
    reg [7:0] tx_data;
    reg tx_start;
    wire tx_serial;
    wire tx_busy;
    wire tx_done;

    wire rx_dv;
    wire [7:0] rx_data;

    // Connect Transmitter
    uart_tx #(
        .CLK_FREQ(50000000),
        .BAUD_RATE(115200)
    ) uut_tx (
        .clk(clk),
        .rst_n(rst_n),
        .tx_data(tx_data),
        .tx_start(tx_start),
        .tx_serial(tx_serial),
        .tx_busy(tx_busy),
        .tx_done(tx_done)
    );

    // Connect Receiver via external serial loopback
    uart_rx #(
        .CLK_FREQ(50000000),
        .BAUD_RATE(115200)
    ) uut_rx (
        .clk(clk),
        .rst_n(rst_n),
        .rx_serial(tx_serial), 
        .rx_dv(rx_dv),
        .rx_data(rx_data)
    );

    // Clock definition: 50 MHz (20ns period toggles every 10ns)
    always #10 clk = ~clk;

    initial begin
        $dumpfile("uart_simulation.vcd");
        $dumpvars(0, uart_tb);

        clk = 0;
        rst_n = 0;
        tx_data = 8'h00;
        tx_start = 0;

        #100;
        rst_n = 1; 
        #40;

        // --- TEST STEP 1: Process Hexadecimal Byte 0xA5 ---
        $display("[TB] Transmitting Byte Data: 8'hA5");
        tx_data = 8'hA5;
        tx_start = 1;
        #20;
        tx_start = 0;

        @(posedge rx_dv);
        $display("[TB] Receiver Collected Data: 8'h%h", rx_data);
        if (rx_data == 8'hA5)
            $display("[TB] SUCCESS: MATCH FOUND FOR BYTE 0xA5");
        else
            $display("[TB] FAILURE: MISMATCH FOR BYTE 0xA5");

        #5000;

        // --- TEST STEP 2: Process Hexadecimal Byte 0x3C ---
        $display("[TB] Transmitting Byte Data: 8'h3C");
        tx_data = 8'h3C;
        tx_start = 1;
        #20;
        tx_start = 0;

        @(posedge rx_dv);
        $display("[TB] Receiver Collected Data: 8'h%h", rx_data);
        if (rx_data == 8'h3C)
            $display("[TB] SUCCESS: MATCH FOUND FOR BYTE 0x3C");
        else
            $display("[TB] FAILURE: MISMATCH FOR BYTE 0x3C");

        #10000;
        $display("[TB] All test patterns verified. Simulation Complete.");
        $finish;
    end
endmodule